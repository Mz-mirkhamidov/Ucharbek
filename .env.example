# ==============================================================================
# UCHARBEK - INNOVATIVE TRAVEL AGENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=3000

# Telegram Bot API Token (From @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJklMNopQRstUVwxyz

# Telegram Chat ID or Group ID for Instant Leads (e.g. -1001234567890 or 987654321)
TELEGRAM_CHAT_ID=-1001234567890

# Optional: Separate Telegram Chat ID for Daily Reports (leave empty to use TELEGRAM_CHAT_ID)
TELEGRAM_REPORT_CHAT_ID=

# Daily Report Time (Tashkent Time UTC+5, 24-hour format HH:MM)
REPORT_TIME=21:00

# Meta / Facebook Pixel ID (Optional)
META_PIXEL_ID=
